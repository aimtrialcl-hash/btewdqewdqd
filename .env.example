DISCORD_TOKEN=replace_with_your_bot_token
DISCORD_CLIENT_ID=replace_with_your_application_id
# The account allowed to use owner-only bot security commands.
BOT_OWNER_ID=replace_with_your_discord_user_id
# Set a long, random secret. Used to protect dashboard write actions.
DASHBOARD_TOKEN=replace_with_a_long_random_secret
# Railway Volume mount path. Attach a volume at /data to persist SQLite data across deploys.
DATA_DIR=/data
PORT=3000
