DISCORD_TOKEN=replace_with_a_new_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# Discord user ID allowed to use owner-only bot security commands.
BOT_OWNER_ID=your_discord_user_id
# Use a long random secret (at least 32 characters) for signed dashboard sessions.
SESSION_SECRET=replace_with_a_long_random_secret
# Public Railway URL, without a trailing slash. Register its /auth/callback URL in the Discord app OAuth2 settings.
DASHBOARD_URL=https://your-service.up.railway.app
# Attach a Railway Volume at /data to persist SQLite records.
DATA_DIR=/data
PORT=3000
